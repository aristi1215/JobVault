{
  "manifest_version": 3,
  "name": "JobVault Capture",
  "version": "0.2.0",
  "description": "Automatically capture job applications from LinkedIn, Indeed, and Glassdoor into JobVault.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://www.glassdoor.com/*",
    "http://localhost:4100/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobVault — Capture Job"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://www.indeed.com/*",
        "https://www.glassdoor.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
